import heapq
 
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)
 
goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)
 
def heuristic(state):
    distance = 0
    for i in range(9):
        if state[i] != 0:
            goal_index = goal.index(state[i])
            distance += abs(i // 3 - goal_index // 3)
            distance += abs(i % 3 - goal_index % 3)
    return distance
 
def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3
    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]
 
    for dr, dc in moves:
        new_row, new_col = row + dr, col + dc
        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_index = new_row * 3 + new_col
            new_state = list(state)
            new_state[zero], new_state[new_index] = (
                new_state[new_index], new_state[zero])
            neighbors.append(tuple(new_state))
 
    return neighbors
 
def a_star(start, goal):
    queue = [(heuristic(start), 0, start, [start])]
    best_cost = {start: 0}
 
    while queue:
        f, g, state, path = heapq.heappop(queue)
 
        if state == goal:
            return path
 
        if g != best_cost.get(state):
            continue
 
        for neighbor in get_neighbors(state):
            new_g = g + 1
            if new_g < best_cost.get(neighbor, float('inf')):
                best_cost[neighbor] = new_g
                new_f = new_g + heuristic(neighbor)
                heapq.heappush(
                    queue, (new_f, new_g, neighbor, path + [neighbor]))
 
    return None
 
path = a_star(start, goal)
 
if path:
    print("A* Search Solution:")
    for step, state in enumerate(path):
        print("\nStep", step)
        for i in range(0, 9, 3):
            print(state[i:i + 3])
    print("\nGoal Reached Successfully!")
    print("Total Moves:", len(path) - 1)
else:
    print("No solution found.")
